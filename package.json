{
  "name": "@dsh-plugin/dsh-git-sidebar",
  "version": "0.1.0",
  "type": "module",
  "description": "Git sidebar panel for DeepSeek Harness: a left-sidebar row that shows the current repository's branch, working-tree status, and recent commits.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-git-sidebar.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-git-sidebar",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-git-sidebar/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "git"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "icon": "./icon.svg"
}
