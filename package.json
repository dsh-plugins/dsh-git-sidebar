{
  "name": "@dsh-plugin/dsh-git-sidebar",
  "version": "0.1.0",
  "type": "module",
  "description": "Git panel for DeepSeek Harness: a Start-page entry in the right Sidebar that opens a Git tab for branch, working-tree status and recent commits.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-git-sidebar.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-git-sidebar",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-git-sidebar/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "git"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs && tsdown --config tsdown.client.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@dsh-plugin/dsh-loader": "^2.0.0-dev.45328381034",
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@dsh-plugin/dsh-monaco": ">=0.1.0-0"
  },
  "peerDependenciesMeta": {
    "@dsh-plugin/dsh-monaco": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.45328381034",
    "@deepseek-ai/cordis": "~4.2.0-alpha.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.3-alpha.2 <0.2.4-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": ["@dsh-plugin/dsh-loader/client"],
      "inject": [
        "@dsh-plugin/dsh-loader",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "icon": "./icon.svg"
}
